# 复制为服务器上的环境变量来源（不要提交真实密钥到 Git）
# 示例：在 systemd 的 Environment= 或 EnvironmentFile= 中引用

# 公网访问地址（换成真实 IP）
CORS_ORIGINS=["http://YOUR_PUBLIC_IP:9999","http://127.0.0.1:9999","https://asset.example.com"]

# 反代真实 IP（与 Nginx proxy_set_header 配合）
PROXY_HEADERS=1
FORWARDED_ALLOW_IPS=127.0.0.1

# 生产关闭热重载
RELOAD=0

# 生产默认不要开 Swagger；验收需要时可临时 SHOW_DOCS=1
SHOW_DOCS=0

# JWT 访问令牌有效期（分钟）。默认代码内 120=2h；可按需调整
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# 可选：固定 SECRET_KEY（多进程时必须一致；单进程可依赖 .secret_key 文件）
# SECRET_KEY=please-change-to-long-random-string
