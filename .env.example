# Copy to your process environment. Do not commit real keys.
SECRET_KEY=
CORS_ORIGINS=["http://127.0.0.1:9999","http://localhost:9999","https://asset.example.com"]
TLS_DOMAIN=asset.example.com
TLS_HTTPS_URL=https://asset.example.com
TLS_HTTP_FALLBACK_URL=http://127.0.0.1:9999
TLS_CERT_PATH=/etc/letsencrypt/live/asset.example.com/fullchain.pem
SHOW_DOCS=0
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
# XAI_API_KEY=
